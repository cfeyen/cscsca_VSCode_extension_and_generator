{
    "breaking_ahead_placeholder": ">~",
    "no_breaking_ahead_placeholder": "!~",
    "breaking_behind_placeholder": "~<",
    "word_placeholder": "w~",
    "escapable_placeholder": "e~",
	"not_escaped_placeholder": "~e",
	"escape_char": "\\\\",
    "breaking_chars": [
        { "char": "\\s", "escapable": false },
        { "char": "^", "escapable": false },
        { "char": "$", "escapable": false },
        { "char": ">", "escapable": true },
        { "char": "<", "escapable": true },
        { "char": "/", "escapable": true },
        { "char": "&", "escapable": true },
        { "char": "!", "escapable": true },
        { "char": "@", "escapable": true },
        { "char": "\\$", "escapable": true },
        { "char": "%", "escapable": true },
        { "char": "\\#", "escapable": true },
        { "char": ",", "escapable": true },
        { "char": "\\*", "escapable": true },
        { "char": "=", "escapable": true },
        { "char": "\\(", "escapable": true },
        { "char": "\\)", "escapable": true },
        { "char": "\\{", "escapable": true },
        { "char": "\\}", "escapable": true },
        { "char": "\\[", "escapable": true },
        { "char": "\\]", "escapable": true },
        { "char": "\\\\", "escapable": true }
    ],
	"comments": [
		{
			"name": "line_comment",
			"token_type": "comment.cscsca",
			"match": "^\\#\\#.*?$"
		},
		{
			"name": "io_msg",
			"token_type": "comment.io.cscsca",
			"match": "(?<=^(PRINT|(GET_AS_CODE|GET\\s*?w~))).+?$"
		}
	],
    "expressions": [
        {
			"name": "statement",
			"token_type": "keyword.cscsca strong.cscsca",
			"match": "^(DEFINE_LAZY|DEFINE|PRINT|GET_AS_CODE|GET)"
		},
        {
			"name": "potentially_special_characters",
			"token_type": "keyword.cscsca",
			"match": "~<(_)>~"
		},
		{
			"name": "bad_escape",
			"token_type": "invalid.bad_escape.cscsca",
			"match": "\\\\(?!e~)(?!$)"
		},
		{
			"name": "newline_escape",
			"token_type": "constant.character.escape.cscsca",
			"match": "\\\\(?=$)"
		},
		{
			"name": "special_characters",
			"token_type": "keyword.cscsca",
			"match": "~e(\\#|\\*|=)"
		},
		{
			"name": "definition_call",
			"token_type": "entity.name.type.cscsca",
			"match": "@w~"
		},
		{
			"name": "variable_call",
			"token_type": "entity.name.type.cscsca emphasis.cscsca",
			"match": "%w~"
		},
		{
			"name": "label",
			"token_type": "entity.name.function.cscsca emphasis.cscsca",
			"match": "\\$(w~)?"
		},
		{
			"name": "definition_name",
			"token_type": "entity.name.type.cscsca",
			"match": "(?<=(^(DEFINE_LAZY|DEFINE)\\s*?))w~"
		},
		{
			"name": "variable_name",
			"token_type": "entity.name.type.cscsca emphasis.cscsca",
			"match": "(?<=(^(GET_AS_CODE|GET)\\s*?))w~"
		},
		{
			"name": "break",
			"token_type": "keyword.control.cscsca",
			"match": "~e(>>|>|<<|<|//|/!|/|&!|!|&)"
		},
		{
			"name": "punctuation",
			"token_type": "punctuation.seperator.cscsca",
			"match": "~e,"
		},
		{
			"name": "scope_bound",
			"token_type": "punctuation.bound.cscsca",
			"match": "~e(\\(|\\)|\\{|\\}|\\[|\\])"
		},
		{
			"name": "numbers",
			"token_type": "constant.numeric.cscsca",
			"match": "\\b[0-9]+\\b"
		},
		{
			"name": "phone",
			"token_type": "variable.phone.cscsca",
			"match": "w~"
		}
	]
}